# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 걸려 있어 커밋되지 않습니다.

# ---------------------------------------------------------------------------
# 1~2단계: 수집(국가법령정보 API) / 저장(PostgreSQL)  — src/lawtrack
# ---------------------------------------------------------------------------
LAW_API_OC=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=law_tracking_db

# ---------------------------------------------------------------------------
# 3단계: 요약 LLM  — summarizer
# ---------------------------------------------------------------------------

# 여기에 API 키를 넣으세요
OPENAI_API_KEY=

# 프로바이더 / 모델
SUMMARY_PROVIDER=openai
SUMMARY_MODEL=gpt-5.4-mini

# --- 원내 모델(Qwen 등)로 바꾸는 경우 ---
# 원내 서버가 OpenAI 호환 엔드포인트를 제공하면(vLLM·Ollama·TGI 등 대부분)
# 코드는 그대로 두고 아래 세 줄만 채우면 됩니다. SUMMARY_BASE_URL 이 있으면
# 외부 OpenAI 로 나가지 않고 그 주소로만 붙습니다.
#   SUMMARY_PROVIDER 는 openai 그대로 둡니다.
# SUMMARY_BASE_URL=http://원내주소:8000/v1
# SUMMARY_MODEL=Qwen/Qwen3.5-122B-FP8
# OPENAI_API_KEY=원내키          # 인증이 없어도 빈 값은 안 됩니다(아무 문자열)
# 자세한 것은 README "원내 모델(Qwen)로 바꾸기" 절 참고.

# --- Anthropic 을 쓰는 경우 ---
# SUMMARY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- OpenRouter(여러 모델을 한 키로 호출하는 중계 서비스)를 쓰는 경우 ---
# 아래 세 줄로 위 OPENAI_API_KEY/SUMMARY_PROVIDER/SUMMARY_MODEL 을 대신합니다.
# base_url(https://openrouter.ai/api/v1)은 코드가 자동으로 채우므로
# SUMMARY_BASE_URL 을 따로 적을 필요 없습니다.
# SUMMARY_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# SUMMARY_MODEL=openai/gpt-4o-mini   # 형식: provider/model — https://openrouter.ai/models 참고

# --- 이하 전부 선택 (없으면 기본값 사용) ---

# 출력 토큰 한도. 응답이 잘리면 올리세요.
# SUMMARY_MAPPING_MAX_TOKENS=4096
# SUMMARY_ARTICLE_MAX_TOKENS=2048
# SUMMARY_LAW_MAX_TOKENS=8192

# 조문 요약 동시 실행 수. rate limit 에 걸리면 낮추세요.
# SUMMARY_MAX_WORKERS=4

# 요약 결과 저장 위치
# SUMMARY_OUTPUT_DIR=out/summaries

LOG_LEVEL=INFO
