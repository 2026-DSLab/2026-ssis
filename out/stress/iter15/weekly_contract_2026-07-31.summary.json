    {
      "law_id": "013242",
      "law_name": "재외국민보호를 위한 영사조력법",
      "law_type": "법률",
      "enforce_date": "2021-04-20",
      "revision_type": "일부개정",
      "source_url": "https://www.law.go.kr/DRF/lawService.do?target=law&MST=231661&type=HTML",
      "new_serial_no": "231661",
      "headline": "일본식 한자어 '지불'을 우리말 '지급'으로 순화",
      "body": "이번 개정은 일반 국민이 법률을 보다 쉽게 이해할 수 있도록 일본식 한자어를 우리말 어법에 맞춰 수정하는 데 목적이 있습니다. 이를 통해 법령의 접근성을 높이고, 국민의 법 이해도를 향상시키고자 하는 의도가 반영되었습니다.\n\n○ 조문별 변경 내용\n- 제19조 (개정): '지불하기'가 '지급하기'로 변경되었습니다.",
      "overview": "이번 개정은 일반 국민이 법률을 보다 쉽게 이해할 수 있도록 일본식 한자어를 우리말 어법에 맞춰 수정하는 데 목적이 있습니다. 이를 통해 법령의 접근성을 높이고, 국민의 법 이해도를 향상시키고자 하는 의도가 반영되었습니다.",
      "caveats": [],
      "article_summaries": [
        {
          "unit": {
            "law_id": "013242",
            "law_name": "재외국민보호를 위한 영사조력법",
            "location_label": "제19조③",
            "change_type": "개정",
            "old_text": "③ 외교부장관은 제1항 단서에 해당하지 아니하는 재외국민이 제1항 본문에 따라 자신이 부담하여야 할 비용을 즉시 지불하기 곤란한 경우로서 해외위난상황으로부터 해당 재외국민을 안전한 지역으로 이동시키기 위한 수단을 투입하는 경우에는 그 비용을 대신하여 지급할 수 있다. 이 경우 해당 재외국민은 외교부장관이 합리적인 범위 내에서 청구하는 비용을 상환하여야 한다.",
            "new_text": "③ 외교부장관은 제1항 단서에 해당하지 아니하는 재외국민이 제1항 본문에 따라 자신이 부담하여야 할 비용을 즉시 지급하기 곤란한 경우로서 해외위난상황으로부터 해당 재외국민을 안전한 지역으로 이동시키기 위한 수단을 투입하는 경우에는 그 비용을 대신하여 지급할 수 있다. 이 경우 해당 재외국민은 외교부장관이 합리적인 범위 내에서 청구하는 비용을 상환하여야 한다.",
            "match_status": "성공",
            "old_text_is_context": false,
            "moved_from": null,
