      "laws": [
        {
          "law_id": "000190",
          "law_type": "법률",
          "law_name": "아동복지법",
          "internal_name": "아동복지법",
          "dept_codes": [],
          "old_serial_no": "281929",
          "new_serial_no": "281929",
          "enforce_date": "2026-07-01",
          "revision_type": "일부개정",
          "revision_reason": "[일부개정] ◇ 개정이유 및 주요내용 아동복지시설의 장, 학교의 장, 위탁가정의 보호자, 보호대상아동의 후견인은 보장원의 장에게 친권행사 제한 또는 친권상실의 선고 청구 요청 등에 대한 법률상담의 지원을 요청할 수 있도록 하고, 보장원의 장은 「법률구조법」에 따라 등록된 법률구조법인 또는 대통령령으로 정하는 기관에 법률상담을 위탁할 수 있도록 함으로써 후견인 선임 절차 등에 어려움을 느끼고 있는 위탁가정의 보호자 등을 지원하려는 것임. <법제처 제공>",
          "source_url": "https://www.law.go.kr/DRF/lawService.do?target=law&MST=281929&type=HTML",
          "articles": [
            {
              "article_label": "제10조의2",
              "clause_no": "②",
              "item_label": "12의2.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "12의2. 제20조의3에 따른 후견인 선임 등에 대한 법률상담의 지원",
              "match_status": "성공"
            },
            {
              "article_label": "제20조의3",
              "clause_no": "①",
              "item_label": "",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "① 보장원의 장은 다음 각 호의 사항에 대한 법률상담을 지원할 수 있다.",
              "match_status": "성공"
            },
            {
              "article_label": "제20조의3",
              "clause_no": "①",
              "item_label": "1.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "1. 제18조에 따른 친권행사의 제한 또는 친권상실의 선고 청구 요청에 관한 사항",
              "match_status": "성공"
            },
            {
              "article_label": "제20조의3",
              "clause_no": "①",
              "item_label": "2.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "2. 제19조에 따른 후견인 선임ㆍ변경 청구에 관한 사항",
              "match_status": "성공"
            },
            {
              "article_label": "제20조의3",
              "clause_no": "①",
              "item_label": "3.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "3. 보호대상아동 후견인의 권한 행사에 관한 사항",
              "match_status": "성공"
            },
            {
              "article_label": "제20조의3",
              "clause_no": "①",
              "item_label": "4.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "4. 그 밖에 보호대상아동의 후견인과 관련하여 대통령령으로 정하는 사항",
              "match_status": "성공"
            },
            {
              "article_label": "제20조의3",
              "clause_no": "②",
              "item_label": "",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "② 아동복지시설의 장, 학교의 장, 가정위탁 보호를 하고 있는 사람 및 보호대상아동의 후견인으로 선임된 사람은 보장원의 장에게 제1항에 따른 법률상담의 지원을 요청할 수 있다.",
              "match_status": "성공"
            },
            {
              "article_label": "제20조의3",
              "clause_no": "③",
              "item_label": "",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "③ 보장원의 장은 「법률구조법」 제3조에 따라 등록된 법률구조법인 또는 대통령령으로 정하는 기관에 제1항 각 호의 사항에 대한 법률상담을 요청할 수 있다.",
              "match_status": "성공"
            },
            {
              "article_label": "제20조의3",
              "clause_no": "④",
              "item_label": "",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "④ 제1항 및 제2항에 따른 법률상담 지원의 범위 및 절차와 제3항에 따른 업무 요청 등에 필요한 사항은 보건복지부령으로 정한다.",
              "match_status": "성공"
            }
          ],
          "structural_expansions": [],
          "unchanged_clauses": {
            "제10조의2": [
              "①",
              "③",
              "④",
              "⑤",
              "⑥",
              "⑦",
              "⑧"
            ]
          }
        }
      ]
    },
    {
      "group_id": "single-009621-286061",
      "promulgation_no": "",
      "promulgation_date": "",
      "revision_type": "",
      "affected_law_ids": [
        "009621"
      ],
      "laws": [
        {
          "law_id": "009621",
          "law_type": "법률",
          "law_name": "유아교육법",
          "internal_name": "유아교육법",
          "dept_codes": [],
          "old_serial_no": "286061",
          "new_serial_no": "286061",
          "enforce_date": "2026-05-19",
          "revision_type": "일부개정",
          "revision_reason": "[일부개정] ◇ 개정이유 및 주요내용 교육부장관은 유치원에 제기된 민원을 공정하고 적법하게 처리할 수 있도록 정보시스템 구축 등이 포함된 계획을 수립ㆍ시행하도록 하고, 교육감은 유치원 민원을 처리하는 교원 등을 보호할 수 있는 방안 등이 포함된 계획을 수립ㆍ시행하도록 하며, 교육부장관 및 교육감은 유아생활지도에 필요한 인력 및 시설 등에 소요되는 경비를 예산의 범위에서 지원할 수 있도록 하고, 보호자는 유아의 발달단계에 적합한 학습이 이루어질 수 있게 노력하도록 하며, 교육부장관은 유아의 건전한 발달을 도모하기 위하여 사교육 실시 및 그 비용 등에 대한 실태를 조사할 수 있도록 하고, 유치원 교사에 보건교사 및 영양교사를 명시하며 해당 자격기준을 추가하려는 것임. <법제처 제공>",
          "source_url": "https://www.law.go.kr/DRF/lawService.do?target=law&MST=286061&type=HTML",
          "articles": [
            {
              "article_label": "제19조의9",
              "clause_no": "①",
              "item_label": "",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "① 교육부장관은 원장이 유치원에 제기된 민원을 공정하고 적법하게 처리할 수 있도록 다음 각 호의 사항을 포함한 계획을 수립ㆍ시행하여야 한다.",
              "match_status": "성공"
            },
            {
              "article_label": "제19조의9",
              "clause_no": "①",
              "item_label": "1.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "1. 유치원 현장의 실정과 특성에 맞춘 민원 처리의 방법 및 절차",
              "match_status": "성공"
            },
            {
              "article_label": "제19조의9",
              "clause_no": "①",
              "item_label": "2.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "2. 제1호의 민원 처리를 전자적으로 하기 위한 정보시스템 구축",
              "match_status": "성공"
            },
            {
              "article_label": "제19조의9",
              "clause_no": "①",
              "item_label": "3.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "3. 제1호의 민원 처리를 위한 행정적ㆍ재정적 지원 방안",
              "match_status": "성공"
            },
            {
              "article_label": "제19조의9",
              "clause_no": "①",
              "item_label": "4.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "4. 그 밖에 유치원 민원 처리를 위하여 필요하다고 교육부장관이 인정한 사항",
              "match_status": "성공"
            },
            {
              "article_label": "제19조의9",
              "clause_no": "②",
              "item_label": "",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "② 교육감은 유치원 민원 처리를 위하여 다음 각 호의 사항을 포함한 계획을 수립ㆍ시행하여야 한다.",
              "match_status": "성공"
            },
            {
              "article_label": "제19조의9",
              "clause_no": "②",
              "item_label": "1.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "1. 유치원 민원을 처리하는 교원 및 직원 등에 대한 보호 방안",
              "match_status": "성공"
            },
            {
              "article_label": "제19조의9",
              "clause_no": "②",
              "item_label": "2.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "2. 제1항제1호의 민원 처리를 위한 행정적ㆍ재정적 세부지원 방안",
              "match_status": "성공"
            },
            {
              "article_label": "제19조의9",
              "clause_no": "②",
              "item_label": "3.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "3. 그 밖에 유치원 민원 처리를 위하여 필요하다고 교육감이 인정한 사항",
              "match_status": "성공"
            },
            {
              "article_label": "제19조의9",
              "clause_no": "③",
              "item_label": "",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "③ 원장은 제1항제1호에 따른 민원 처리의 방법 및 절차에 관한 사항을 보호자에게 정기적으로 안내하여야 한다.",
              "match_status": "성공"
            },
            {
              "article_label": "제21조의3",
              "clause_no": "③",
              "item_label": "",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "③ 교육부장관 및 교육감은 제1항에 따른 유아생활지도에 필요한 인력 및 시설 등에 소요되는 경비를 예산의 범위에서 지원할 수 있다.",
              "match_status": "성공"
            },
            {
              "article_label": "제21조의4",
              "clause_no": "④",
              "item_label": "",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "④ 보호자는 유아의 발달단계에 적합한 학습이 이루어질 수 있도록 노력하여야 한다.",
              "match_status": "성공"
            },
            {
              "article_label": "제21조의6",
              "clause_no": "",
              "item_label": "",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "유치원과 원장은 교원의 전화번호, 주민등록번호 등 개인정보가 「개인정보 보호법」 및 「공공기관의 정보공개에 관한 법률」 등 관계 법률에 따라 보호될 수 있도록 필요한 조치를 하여야 한다.",
              "match_status": "성공"
            },
            {
              "article_label": "제22조",
              "clause_no": "②",
              "item_label": "",
              "subitem_label": "",
              "change_type": "개정",
              "old_text": "②교사는 정교사(1급ㆍ2급)ㆍ준교사로 나누되, 별표 2의 자격기준에 해당하는 사람으로서 대통령령으로 정하는 바에 따라 교육부장관이 검정ㆍ수여하는 자격증을 받은 사람이어야 한다.",
              "new_text": "②교사는 정교사(1급ㆍ2급), 준교사, 보건교사(1급ㆍ2급) 및 영양교사(1급ㆍ2급)로 나누되, 별표 2의 자격기준에 해당하는 사람으로서 대통령령으로 정하는 바에 따라 교육부장관이 검정ㆍ수여하는 자격증을 받은 사람이어야 한다.",
              "match_status": "성공"
            }
          ],
          "structural_expansions": [
            {
              "article_label": "제21조의5",
              "old_text": "유치원과 원장은 교원의 전화번호, 주민등록번호 등 개인정보가 「개인정보 보호법」 및 「공공기관의 정보공개에 관한 법률」 등 관계 법률에 따라 보호될 수 있도록 필요한 조치를 하여야 한다.",
              "new_items": [
                {
                  "clause_no": "①",
                  "item_label": "",
                  "subitem_label": "",
                  "text": "① 교육부장관은 유아의 건전한 발달과 유치원 교육과정 등의 정상적인 운영을 위하여 사교육 실시 및 그 비용 등에 대한 실태를 조사할 수 있다."
                },
                {
                  "clause_no": "②",
                  "item_label": "",
                  "subitem_label": "",
                  "text": "② 교육부장관은 제1항에 따른 실태조사에 필요한 인력과 예산을 확보하도록 노력하여야 한다."
                },
                {
                  "clause_no": "③",
                  "item_label": "",
                  "subitem_label": "",
                  "text": "③ 제1항에 따른 실태조사의 범위와 방법 등에 필요한 사항은 대통령령으로 정한다."
                }
              ]
            }
          ],
          "unchanged_clauses": {
            "제22조": [
              "①",
              "③",
              "④",
              "⑤"
            ],
            "제21조의3": [
              "①",
              "②"
            ],
            "제21조의4": [
              "①",
              "②",
              "③"
            ]
          }
        }
      ]
    },
    {
