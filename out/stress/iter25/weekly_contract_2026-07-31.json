              "clause_no": "①",
              "item_label": "3.",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "3. 제1호의 민원 처리를 위한 행정적ㆍ재정적 지원 방안",
              "match_status": "성공"
