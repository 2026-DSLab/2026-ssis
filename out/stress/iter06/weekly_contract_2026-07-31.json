    {
      "group_id": "single-73493-2100000281400",
      "promulgation_no": "",
      "promulgation_date": "",
      "revision_type": "",
      "affected_law_ids": [
        "73493"
      ],
      "laws": [
        {
          "law_id": "73493",
          "law_type": "행정규칙",
          "law_name": "개인정보의 안전성 확보조치 기준",
          "internal_name": "개인정보의 안전성 확보조치 기준",
          "dept_codes": [],
          "old_serial_no": "2100000281400",
          "new_serial_no": "2100000281400",
          "enforce_date": "2026-07-01",
          "revision_type": "일부개정",
          "revision_reason": "◇ 개정이유 ○ 지난 5년간 유출신고가 접수된 공공부문 유출사고 중 해킹 신고 건수의 비중은 약 33%이나, 해킹으로 인한 유출규모(약 95%)가 가장 큰 것으로 나타남에 따라 개인정보 유출이 심각하여 사전 예방조치 의무가 필요한 상황임 ○ 아울러, 현행 규정은 개인정보처리자가 내부 관리계획을 통해 취약점 점검 등의 이행실태를 연 1회이상 점검하도록 하고 있으나, 명시적인 규정은 마련되어 있지 않았음 ○ 이에 공공시스템운영기관에 대해서는 공공시스템별로 연 1회 이상 취약점 점검 및 침투테스트를 실시하도록 하고, 이를 보완토록 하여 국민의 개인정보를 처리하는 공공기관의 개인정보 보호 수준을 강화할 수 있도록 하려는 것임 ◇ 주요내용 가. 공공시스템운영기관의 내부 관리계획의 수립ㆍ시행(안 제15조) 공공시스템운영기관이 공공시스템 별로 내부 관리 계획을 ‘수립’하는 것을 ‘수립ㆍ시행’하는 것으로 수정하고, 신설되는 18조(공공시스템운영기관의 취약점 점검 및 조치)를 내부 관리계획 수립시행 대상으로 포함 나. 공공시스템운영기관의 취약점 점검 및 조치(안 제18조) 공공시스템운영기관이 취약점 점검 및 외부 전문기관 또는 외부 전문가에 의한 침투테스트를 공공시스템별로 연 1회 이상 실시하고 점검 결과에 따른 보완조치를 지체 없이 시행하도록 함 다. 부칙 15조 제5호 및 제18조는 2027년 1월 1일부터 시행하도록 함",
          "source_url": "https://www.law.go.kr/DRF/lawService.do?target=admrul&ID=2100000281400&type=HTML",
          "articles": [
            {
              "article_label": "제15조",
              "clause_no": "",
              "item_label": "",
              "subitem_label": "",
              "change_type": "개정",
              "old_text": "공공시스템운영기관은 공공시스템 별로 다음 각 호의 사항을 포함하여 내부 관리계획을 수립하여야 한다.",
              "new_text": "공공시스템운영기관은 공공시스템 별로 다음 각 호의 사항을 포함하여 내부 관리계획을 수립ㆍ시행하여야 한다.",
              "match_status": "성공"
            },
            {
              "article_label": "제15조",
              "clause_no": "",
              "item_label": "5.",
              "subitem_label": "",
              "change_type": "개정",
              "old_text": "5. 제16조 및 제17조에 관한 사항",
              "new_text": "5. 제16조부터 제18조까지에 관한 사항",
              "match_status": "성공"
            },
            {
              "article_label": "제19조",
              "clause_no": "",
              "item_label": "",
              "subitem_label": "",
              "change_type": "신설",
              "old_text": "",
              "new_text": "개인정보보호위원회는 「행정규제기본법」 제8조 및 「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 이 고시에 대하여 2023년 9월 15일을 기준으로 매 3년이 되는 시점(매 3년째의 9월 14일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.",
              "match_status": "성공"
            }
          ],
