              "new_text": "② 직원은 다음 각 호의 어느 하나에 해당하는 직을 겸직할 수 없다.",
              "match_status": "성공"
            },
            {
              "article_label": "제10조의4",
              "clause_no": "②",
              "item_label": "1.",
